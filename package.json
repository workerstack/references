{
  "name": "@workerstack/references",
  "version": "0.1.1",
  "description": "An index of every published @workerstack package, for agents and for repo sync",
  "license": "MIT",
  "author": "Lovro Žagar",
  "homepage": "https://github.com/workerstack/references#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerstack/references.git"
  },
  "bugs": {
    "url": "https://github.com/workerstack/references/issues"
  },
  "keywords": [
    "workerstack",
    "references",
    "agents"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "files": [
    "references"
  ],
  "exports": {
    "./references/*": "./references/*",
    "./package.json": "./package.json"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "repo sync --postinstall"
  },
  "devDependencies": {
    "@workerstack/repo": "0.1.0"
  }
}
